
<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Los Angeles Open World V2</title>
<style>
*{box-sizing:border-box}
body{margin:0;overflow:hidden;background:#101722;color:white;font-family:Arial}
canvas{display:block}
#hud,#mission,#help{
 position:fixed;background:#10151ddd;padding:13px;
 border:1px solid #ffffff30;border-radius:12px;z-index:5;
 line-height:1.7;font-size:13px
}
#hud{top:12px;left:12px;min-width:175px}
#hud b{font-size:19px;color:#ffd34e}
#mission{top:12px;right:12px;text-align:center}
#help{bottom:12px;left:12px}
#message{
 position:fixed;top:45%;left:50%;transform:translate(-50%,-50%);
 background:#111e;padding:16px 24px;border-radius:12px;
 display:none;z-index:8;text-align:center;font-weight:bold
}
#buttons{position:fixed;right:12px;bottom:12px;display:none;
 grid-template-columns:repeat(3,55px);gap:6px;z-index:8}
#buttons button{height:52px;border:1px solid #ffffff70;
 border-radius:10px;background:#333b;color:white;font-size:23px}
@media(max-width:700px){#buttons{display:grid}#help{bottom:185px}}
</style>
</head>
<body>

<div id="hud">
 <b>LOS ANGELES</b><br>
 OPEN WORLD V2<br>
 Snelheid: <span id="speed">0</span> km/u<br>
 Politie: <span id="stars">☆☆☆☆☆</span><br>
 Tijd: <span id="time">12:00</span>
</div>

<div id="mission">
 <b>MISSIES</b><br>
 Ringen: <span id="score">0</span>/10<br>
 <small>Verzamel de gouden ringen</small>
</div>

<div id="help">
 ↑ Vooruit | ↓ Achteruit<br>
 ← Links | → Rechts<br>
 SPATIE Remmen<br>
 N Dag/nacht | P Politie
</div>

<div id="message"></div>

<div id="buttons">
 <button data-key="ArrowUp" style="grid-column:2">↑</button>
 <button data-key="ArrowLeft">←</button>
 <button data-key="ArrowDown">↓</button>
 <button data-key="ArrowRight">→</button>
 <button data-key=" " style="grid-column:2">■</button>
</div>

<script type="module">
import * as THREE from
'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js';

// SCENE
const scene=new THREE.Scene();
scene.background=new THREE.Color(0x83b8df);
scene.fog=new THREE.Fog(0x83b8df,120,650);

const camera=new THREE.PerspectiveCamera(
 70,innerWidth/innerHeight,0.1,1200
);

const renderer=new THREE.WebGLRenderer({antialias:false});
renderer.setSize(innerWidth,innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio,1.3));
renderer.outputColorSpace=THREE.SRGBColorSpace;
document.body.appendChild(renderer.domElement);

// LIGHTS
const hemi=new THREE.HemisphereLight(0xffffff,0x59634d,1.8);
scene.add(hemi);
const sun=new THREE.DirectionalLight(0xffe5c0,2);
sun.position.set(-60,100,40);
scene.add(sun);

// MATERIALS
const material=(c,r=.8,m=0)=>new THREE.MeshStandardMaterial({
 color:c,roughness:r,metalness:m
});
const roadMat=material(0x292d32);
const grassMat=material(0x536d4c);
const pavementMat=material(0x999999);
const whiteMat=material(0xffffff);
const glassMat=material(0x183748,.2,.3);
const tireMat=material(0x111111);
const rimMat=material(0x999999,.3,.7);

function box(parent,w,h,d,mat,x,y,z){
 const mesh=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mat);
 mesh.position.set(x,y,z);
 parent.add(mesh);
 return mesh;
}

// GROUND
const ground=new THREE.Mesh(
 new THREE.PlaneGeometry(1400,1400),grassMat
);
ground.rotation.x=-Math.PI/2;
ground.position.y=-.15;
scene.add(ground);

// ROADS
box(scene,22,.12,1200,roadMat,0,-.04,0);
for(let z=-500;z<=500;z+=100){
 box(scene,120,.12,14,roadMat,0,-.035,z);
}
for(const x of [-13,13]){
 box(scene,4,.3,1200,pavementMat,x,0,0);
}
for(let z=-590;z<600;z+=12){
 box(scene,.2,.035,5,whiteMat,0,.04,z);
}

// CITY BUILDINGS
const buildingMats=[
 material(0xaaa99e),material(0xc1b29d),
 material(0x777e88),material(0x9eafb5),
 material(0x827c72),material(0xd0c6b2),
 material(0x596b79)
];
const windowMat=material(0x77a9c0,.3,.2);

for(const side of [-1,1]){
 for(let i=0;i<45;i++){
  const z=-480+i*23;
  const x=side*(28+Math.random()*30);
  const w=9+Math.random()*10;
  const d=12+Math.random()*12;
  const h=12+Math.random()*65;

  const building=new THREE.Group();
  building.position.set(x,0,z);
  scene.add(building);

  box(building,w,h,d,
   buildingMats[Math.floor(Math.random()*buildingMats.length)],
   0,h/2,0);

  for(let floor=1;floor<h/4;floor++){
   for(let col=-1;col<=1;col++){
    box(building,1.3,1.5,.12,windowMat,
     col*w/3,floor*3.5,d/2+.08);
   }
  }
  box(building,w+.4,.5,d+.4,material(0x55575b),0,h+.25,0);
 }
}

// TREES
const trunk=material(0x61442d);
const leaves=material(0x315d38);
for(let z=-480;z<500;z+=22){
 for(const x of [-15,15]){
  box(scene,.6,3,.6,trunk,x,1.5,z);
  const tree=new THREE.Mesh(
   new THREE.SphereGeometry(2.2,7,6),leaves
  );
  tree.position.set(x,4,z);
  scene.add(tree);
 }
}

// CAR CREATOR
function makeCar(color=0xb50020,police=false){
 const car=new THREE.Group();
 const paint=material(color,.28,.55);

 box(car,2.15,.75,4.4,paint,0,.9,0);
 box(car,1.75,.8,2.2,glassMat,0,1.55,.05);

 const wheels=[];
 for(const x of [-1.12,1.12]){
  for(const z of [-1.4,1.4]){
   const wheel=new THREE.Mesh(
    new THREE.CylinderGeometry(.45,.45,.32,16),tireMat
   );
   wheel.rotation.z=Math.PI/2;
   wheel.position.set(x,.5,z);
   car.add(wheel);
   wheels.push(wheel);

   const rim=new THREE.Mesh(
    new THREE.CylinderGeometry(.22,.22,.34,12),rimMat
   );
   rim.rotation.z=Math.PI/2;
   rim.position.copy(wheel.position);
   car.add(rim);
  }
 }

 for(const x of [-.72,.72]){
  box(car,.48,.18,.1,material(0xffffcc),x,1,-2.22);
  box(car,.48,.18,.1,material(0xff1111),x,1,2.22);
 }

 let lights=[];
 if(police){
  box(car,.9,.18,.4,material(0x202020),0,2.05,0);
  lights=[
   box(car,.35,.25,.25,material(0xff0000),-.23,2.2,0),
   box(car,.35,.25,.25,material(0x004cff),.23,2.2,0)
  ];
 }
 car.userData.wheels=wheels;
 car.userData.lights=lights;
 return car;
}

// PLAYER
const player=makeCar(0xb50020);
scene.add(player);
player.position.set(0,0,0);

// TRAFFIC
const traffic=[];
const colors=[0xeeeeee,0x151515,0x163b85,0x777777,0xb4a28c,0x23834a];

for(let i=0;i<18;i++){
 const direction=i%2===0?1:-1;
 const car=makeCar(colors[i%colors.length]);
 car.position.set(direction===1?-4:4,0,-450+Math.random()*900);
 if(direction===-1)car.rotation.y=Math.PI;
 scene.add(car);
 traffic.push({mesh:car,direction,speed:.12+Math.random()*.15});
}

// PEDESTRIANS
const pedestrians=[];
const skinColors=[0xd6a47b,0x9c6847,0xf0c49b];
for(let i=0;i<30;i++){
 const person=new THREE.Group();
 box(person,.6,1.25,.4,material([0x315b9b,0x9d3434,0x4a7950,0xdddddd][i%4]),0,1.15,0);
 const head=new THREE.Mesh(
  new THREE.SphereGeometry(.27,8,8),
  material(skinColors[i%3])
 );
 head.position.y=1.95;
 person.add(head);
 for(const x of [-.16,.16]){
  box(person,.18,.8,.18,tireMat,x,.4,0);
 }
 person.position.set(i%2?15:-15,0,-450+Math.random()*900);
 scene.add(person);
 pedestrians.push({
  mesh:person,direction:Math.random()>.5?1:-1,
  speed:.025+Math.random()*.025
 });
}

// TRAFFIC LIGHTS
const lights=[];
for(let z=-500;z<=500;z+=100){
 for(const x of [-14,14]){
  box(scene,.25,7,.25,tireMat,x,3.5,z);
  const group=new THREE.Group();
  group.position.set(x,6.5,z);
  scene.add(group);
  for(let j=0;j<3;j++){
   const lamp=new THREE.Mesh(
    new THREE.SphereGeometry(.22,8,8),
    material([0xff2222,0xffbb00,0x00cc55][j])
   );
   lamp.position.y=-j*.55;
   group.add(lamp);
  }
  lights.push(group);
 }
}

// MISSION RINGS
const rings=[];
const ringMat=new THREE.MeshStandardMaterial({
 color:0xffc600,emissive:0x996600,
 metalness:.5,roughness:.25
});
for(let i=0;i<10;i++){
 const ring=new THREE.Mesh(
  new THREE.TorusGeometry(2,.22,8,24),ringMat
 );
 ring.position.set(i%2===0?-7:7,1.8,-80-i*42);
 scene.add(ring);
 rings.push(ring);
}

// POLICE
let police=null;
let wanted=0;
let policeActive=false;
let policeCooldown=0;

function message(text){
 const el=document.getElementById('message');
 el.textContent=text;
 el.style.display='block';
 messageTime=150;
}
let messageTime=0;

function startPolice(){
 if(policeActive)return;
 police=makeCar(0xffffff,true);
 police.position.set(player.position.x+12,0,player.position.z+35);
 scene.add(police);
 policeActive=true;
 wanted=1;
 message("POLITIE ACHTER JE AAN!");
}

function stopPolice(){
 if(police)scene.remove(police);
 police=null;
 policeActive=false;
 wanted=0;
}

// INPUT
const keys={};
window.addEventListener('keydown',e=>{
 if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' '].includes(e.key)){
  e.preventDefault();
 }
 keys[e.key]=true;
 if(e.key.toLowerCase()==='n')toggleNight();
 if(e.key.toLowerCase()==='p')startPolice();
});
window.addEventListener('keyup',e=>keys[e.key]=false);

document.querySelectorAll('[data-key]').forEach(btn=>{
 const key=btn.dataset.key;
 btn.addEventListener('pointerdown',e=>{
  e.preventDefault();keys[key]=true;
 });
 for(const event of ['pointerup','pointerleave','pointercancel']){
  btn.addEventListener(event,()=>keys[key]=false);
 }
});

// DAY AND NIGHT
let night=false;
function toggleNight(){
 night=!night;
 scene.background.set(night?0x071326:0x83b8df);
 scene.fog.color.set(night?0x071326:0x83b8df);
 hemi.intensity=night?.35:1.8;
 sun.intensity=night?.15:2;
 sun.color.set(night?0x7899ff:0xffe5c0);
 message(night?"NACHTMODUS":"DAGMODUS");
}

// GAME
let velocity=0;
let steering=0;
let score=0;
let gameTime=12;
const gameClock=new THREE.Clock();

function updateHUD(){
 document.getElementById('speed').textContent=
 Math.round(Math.abs(velocity)*120);
 document.getElementById('stars').textContent=
 '★'.repeat(wanted)+'☆'.repeat(5-wanted);
 document.getElementById('score').textContent=score;
 document.getElementById('time').textContent=
 String(Math.floor(gameTime)).padStart(2,'0')+':'+
 String(Math.floor((gameTime%1)*60)).padStart(2,'0');
}

function animate(){
 requestAnimationFrame(animate);
 const delta=Math.min(gameClock.getDelta(),.04);

 // CAR CONTROLS
 if(keys.ArrowUp)velocity+=.012;
 if(keys.ArrowDown)velocity-=.012;
 if(keys[' '])velocity*=.88;
 velocity*=.993;
 velocity=THREE.MathUtils.clamp(velocity,-.45,1.05);

 if(keys.ArrowLeft)steering=1;
 else if(keys.ArrowRight)steering=-1;
 else steering*=.85;

 if(Math.abs(velocity)>.005){
  player.rotation.y+=steering*Math.abs(velocity)*.035*
   (velocity<0?-1:1);
 }

 player.position.x-=Math.sin(player.rotation.y)*velocity;
 player.position.z-=Math.cos(player.rotation.y)*velocity;
 player.position.x=THREE.MathUtils.clamp(player.position.x,-9,9);

 for(const wheel of player.userData.wheels){
  wheel.rotation.x+=velocity*.4;
 }

 // TRAFFIC
 for(const t of traffic){
  t.mesh.position.z+=t.speed*t.direction;
  if(t.mesh.position.z>520)t.mesh.position.z=-520;
  if(t.mesh.position.z< -520)t.mesh.position.z=520;

  if(t.mesh.position.distanceTo(player.position)<3.2){
   velocity*=.96;
  }
 }

 // PEDESTRIANS
 for(const p of pedestrians){
  p.mesh.position.z+=p.speed*p.direction;
  if(p.mesh.position.z>510)p.mesh.position.z=-510;
  if(p.mesh.position.z< -510)p.mesh.position.z=510;
 }

 // POLICE CHASE
 if(policeActive&&police){
  const diff=player.position.clone().sub(police.position);
  const distance=diff.length();
  if(distance>3){
   const desired=Math.atan2(-diff.x,-diff.z);
   let angle=desired-police.rotation.y;
   angle=Math.atan2(Math.sin(angle),Math.cos(angle));
   police.rotation.y+=angle*.035;
   police.position.x-=Math.sin(police.rotation.y)*.25;
   police.position.z-=Math.cos(police.rotation.y)*.25;
  }
  police.userData.lights.forEach((light,i)=>{
   light.material.color.set(
    Math.sin(performance.now()*.012+i*Math.PI)>0?
    (i===0?0xff0000:0x004cff):0x222222
   );
  });
  if(distance<5)velocity*=.97;
  policeCooldown++;
  if(policeCooldown>1800){
   stopPolice();policeCooldown=0;
  }
 }

 // COLLECT RINGS
 for(let i=rings.length-1;i>=0;i--){
  const ring=rings[i];
  ring.rotation.y+=.025;
  if(ring.position.distanceTo(player.position)<4){
   scene.remove(ring);
   rings.splice(i,1);
   score++;
   message(score===10?"ALLE MISSIES VOLTOOID!":"MISSIEPUNT VERZAMELD!");
  }
 }

 // GAME TIME
 gameTime=(gameTime+delta*.015)%24;

 // CAMERA
 const offset=new THREE.Vector3(0,6,12);
 offset.applyAxisAngle(new THREE.Vector3(0,1,0),player.rotation.y);
 camera.position.lerp(player.position.clone().add(offset),.08);
 const look=player.position.clone();
 look.y+=1;
 look.z-=4*Math.cos(player.rotation.y);
 look.x-=4*Math.sin(player.rotation.y);
 camera.lookAt(look);

 if(messageTime>0){
  messageTime--;
  if(messageTime===0)document.getElementById('message').style.display='none';
 }

 updateHUD();
 renderer.render(scene,camera);
}

animate();

window.addEventListener('resize',()=>{
 camera.aspect=innerWidth/innerHeight;
 camera.updateProjectionMatrix();
 renderer.setSize(innerWidth,innerHeight);
});
</script>
</body>
</html>
